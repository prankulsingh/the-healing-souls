---
import BaseLayout from "@layouts/BaseLayout.astro";
import SafetyNote from "@components/global/SafetyNote.astro";
---
<BaseLayout title="Private journal | The Healing Souls" description="Local-only journal prompts for private reflection.">
  <section class="section"><div class="container-narrow stack"><p class="eyebrow">Reflect privately</p><h1>Private journal</h1><p class="lede">MVP note: journal storage is intentionally not connected to a server. Full local save/export/delete controls should be implemented before this becomes an active text tool.</p><SafetyNote /></div></section>
  <section class="section"><div class="container card stack"><h2>Prompt for today</h2><p class="lede">What is one feeling asking for your attention, and what is one gentle next step?</p><p class="muted">Write in your own notebook for now. Local-only browser storage is planned next.</p></div></section>
</BaseLayout>
