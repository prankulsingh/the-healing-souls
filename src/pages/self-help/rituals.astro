---
import BaseLayout from "@layouts/BaseLayout.astro";
import LinkCard from "@components/cards/LinkCard.astro";
import { resourceArticlePath, resourceArticles } from "@data/self-help-resources";

const related = resourceArticles.filter((article) => ["a-reset-for-heavy-days", "burnout-is-not-laziness", "when-sleep-feels-far-away"].includes(article.slug));
---
<BaseLayout title="Short rituals | The Healing Souls" description="Short reset rituals for different parts of the day.">
  <section class="section">
    <div class="container-narrow stack">
      <p class="eyebrow">Rituals</p>
      <h1>Short routines for hard and ordinary days.</h1>
      <p class="lede">Choose how much time you have, what state you are in, and where this ritual needs to fit. The page will build a three-step reset without streaks, scoring, or guilt.</p>
    </div>
  </section>

  <section class="section">
    <div class="container card ritual-builder stack" data-ritual-builder>
      <div class="tool-controls">
        <div>
          <p class="eyebrow">Time available</p>
          <div class="choice-grid" role="group" aria-label="Time available">
            <button class="choice-chip is-active" type="button" data-time="1">1 min</button>
            <button class="choice-chip" type="button" data-time="3">3 min</button>
            <button class="choice-chip" type="button" data-time="5">5 min</button>
            <button class="choice-chip" type="button" data-time="10">10 min</button>
          </div>
        </div>
        <div>
          <p class="eyebrow">Current state</p>
          <div class="choice-grid" role="group" aria-label="Current state">
            <button class="choice-chip is-active" type="button" data-state="scattered">Scattered</button>
            <button class="choice-chip" type="button" data-state="heavy">Heavy</button>
            <button class="choice-chip" type="button" data-state="restless">Restless</button>
            <button class="choice-chip" type="button" data-state="numb">Numb</button>
            <button class="choice-chip" type="button" data-state="drained">Drained</button>
          </div>
        </div>
        <div>
          <p class="eyebrow">Context</p>
          <div class="choice-grid" role="group" aria-label="Context">
            <button class="choice-chip is-active" type="button" data-context="morning">Morning</button>
            <button class="choice-chip" type="button" data-context="work">Work break</button>
            <button class="choice-chip" type="button" data-context="conflict">After conflict</button>
            <button class="choice-chip" type="button" data-context="sleep">Before sleep</button>
            <button class="choice-chip" type="button" data-context="hard-day">Hard day</button>
          </div>
        </div>
      </div>

      <div class="button-row">
        <button id="ritual-generate" class="button button-primary" type="button">Generate ritual</button>
        <button id="ritual-save" class="button button-secondary" type="button">Save favourite</button>
        <button id="ritual-start" class="button button-soft" type="button">Start timer</button>
      </div>

      <div class="ritual-output card stack">
        <div class="article-meta">
          <span id="ritual-meta">1 min / scattered / morning</span>
          <span id="ritual-timer">Timer idle</span>
        </div>
        <h2 id="ritual-title">A small return to now</h2>
        <ol id="ritual-steps" class="check-list">
          <li><label><input type="checkbox" /> Take one slow breath and notice where your body is supported.</label></li>
          <li><label><input type="checkbox" /> Drink water or unclench one part of your body.</label></li>
          <li><label><input type="checkbox" /> Name one next step small enough to begin.</label></li>
        </ol>
        <p class="muted">Closing note: What do you want to carry into the next hour?</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <div class="split-heading">
        <div>
          <p class="eyebrow">Saved favourites</p>
          <h2>Recently useful routines.</h2>
        </div>
        <p class="lede">Save the routines that feel kind enough to repeat on another hard or ordinary day.</p>
      </div>
      <div id="ritual-favourites" class="resource-list"></div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <div class="split-heading">
        <div>
          <p class="eyebrow">Related reading</p>
          <h2>When a ritual opens the door to more care.</h2>
        </div>
        <p class="lede">Resources for heavy days, burnout, and sleep wind-down.</p>
      </div>
      <div class="grid grid-3">
        {related.map((article) => <LinkCard title={article.title} text={article.description} href={resourceArticlePath(article.slug)} cta="Read guide" />)}
      </div>
    </div>
  </section>

  <script is:inline>
    const ritualState = { time: "1", state: "scattered", context: "morning" };
    const ritualSteps = {
      scattered: ["Put both feet on the floor and name three objects.", "Write the one thing that is actually next.", "Close every tab or thought you do not need for this minute."],
      heavy: ["Lower the standard for this block of time.", "Drink water or eat one small thing if you can.", "Choose one task that would make the day 1 percent lighter."],
      restless: ["Exhale longer than you inhale three times.", "Unclench your jaw, hands, and shoulders.", "Move slowly for ten steps or stretch your wrists."],
      numb: ["Name the room, date, and one neutral fact.", "Touch a texture near you for five breaths.", "Write one sentence beginning with: A part of me feels..."],
      drained: ["Sit down if you are standing, or soften your posture.", "Cancel or delay one non-urgent demand if possible.", "Choose the smallest recovery action available."],
    };
    const contextOpeners = {
      morning: "A gentle beginning",
      work: "A work-break reset",
      conflict: "A repair after conflict",
      sleep: "A sleep wind-down",
      "hard-day": "A hard-day softening",
    };

    const outputTitle = document.querySelector("#ritual-title");
    const outputMeta = document.querySelector("#ritual-meta");
    const stepsEl = document.querySelector("#ritual-steps");
    const timerEl = document.querySelector("#ritual-timer");
    const favouritesEl = document.querySelector("#ritual-favourites");
    let timer;

    const setActive = (selector, key, value, clicked) => {
      ritualState[key] = value;
      document.querySelectorAll(selector).forEach((button) => button.classList.toggle("is-active", button === clicked));
    };

    const currentRitual = () => ({
      title: contextOpeners[ritualState.context],
      meta: `${ritualState.time} min / ${ritualState.state} / ${ritualState.context.replace("-", " ")}`,
      steps: ritualSteps[ritualState.state],
    });

    const renderRitual = () => {
      const ritual = currentRitual();
      outputTitle.textContent = ritual.title;
      outputMeta.textContent = ritual.meta;
      stepsEl.innerHTML = "";
      ritual.steps.forEach((step) => {
        const item = document.createElement("li");
        const label = document.createElement("label");
        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        label.append(checkbox, ` ${step}`);
        item.append(label);
        stepsEl.append(item);
      });
    };

    const renderFavourites = () => {
      const favourites = JSON.parse(localStorage.getItem("hs-favourite-rituals") || "[]");
      favouritesEl.innerHTML = "";
      if (!favourites.length) {
        favouritesEl.innerHTML = '<p class="muted">No favourite rituals saved yet.</p>';
        return;
      }
      favourites.slice().reverse().forEach((ritual) => {
        const article = document.createElement("article");
        article.className = "card resource-row";
        article.innerHTML = `<div><div class="article-meta"><span>Favourite</span><span>${ritual.meta}</span></div><h3>${ritual.title}</h3><p class="muted">${ritual.steps.join(" ")}</p></div>`;
        favouritesEl.append(article);
      });
    };

    document.querySelectorAll("[data-time]").forEach((button) => button.addEventListener("click", () => setActive("[data-time]", "time", button.dataset.time, button)));
    document.querySelectorAll("[data-state]").forEach((button) => button.addEventListener("click", () => setActive("[data-state]", "state", button.dataset.state, button)));
    document.querySelectorAll("[data-context]").forEach((button) => button.addEventListener("click", () => setActive("[data-context]", "context", button.dataset.context, button)));
    document.querySelector("#ritual-generate")?.addEventListener("click", renderRitual);
    document.querySelector("#ritual-save")?.addEventListener("click", () => {
      const favourites = JSON.parse(localStorage.getItem("hs-favourite-rituals") || "[]").slice(-9);
      favourites.push(currentRitual());
      localStorage.setItem("hs-favourite-rituals", JSON.stringify(favourites));
      renderFavourites();
    });
    document.querySelector("#ritual-start")?.addEventListener("click", () => {
      clearInterval(timer);
      let remaining = Number(ritualState.time) * 60;
      timerEl.textContent = `${remaining}s remaining`;
      timer = setInterval(() => {
        remaining -= 1;
        timerEl.textContent = remaining > 0 ? `${remaining}s remaining` : "Complete";
        if (remaining <= 0) clearInterval(timer);
      }, 1000);
    });

    renderRitual();
    renderFavourites();
  </script>
</BaseLayout>
