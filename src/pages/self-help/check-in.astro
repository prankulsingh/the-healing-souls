---
import BaseLayout from "@layouts/BaseLayout.astro";
import LinkCard from "@components/cards/LinkCard.astro";
import { resourceArticlePath, resourceArticles } from "@data/self-help-resources";
import { sitePath } from "@data/site-path";

const related = resourceArticles.filter((article) => ["what-self-worth-sounds-like-on-a-bad-day", "burnout-is-not-laziness", "when-your-mind-will-not-slow-down"].includes(article.slug));
---
<BaseLayout title="Mood check-in | The Healing Souls" description="A non-diagnostic check-in that routes you to a gentle next step.">
  <section class="section">
    <div class="container-narrow stack">
      <p class="eyebrow">Check in</p>
      <h1>What feels closest right now?</h1>
      <p class="lede">Use this as a soft routing aid, not a diagnosis. Pick a feeling family, add a few context tags, and receive one practical next step.</p>
    </div>
  </section>

  <section class="section">
    <div class="container card checkin-tool stack" data-checkin-tool>
      <div class="split-heading">
        <div>
          <p class="eyebrow">Step 1</p>
          <h2>Choose a feeling family.</h2>
        </div>
        <p class="lede">The labels are only language. You can choose the closest one and change your mind.</p>
      </div>
      <div class="feeling-map" role="group" aria-label="Feeling family">
        <button type="button" data-feeling="scattered" class="feeling-tile tile-sage"><strong>Scattered</strong><span>Looping, pulled in many directions</span></button>
        <button type="button" data-feeling="heavy" class="feeling-tile tile-rose"><strong>Heavy</strong><span>Sad, slow, weighed down</span></button>
        <button type="button" data-feeling="restless" class="feeling-tile tile-gold"><strong>Restless</strong><span>Tired but wired, hard to settle</span></button>
        <button type="button" data-feeling="numb" class="feeling-tile tile-mauve"><strong>Numb</strong><span>Flat, distant, checked out</span></button>
      </div>

      <div class="refine-panel stack">
        <p class="eyebrow">Step 2</p>
        <h3>What else is true?</h3>
        <div class="grid grid-3">
          <div>
            <p class="field-label">Energy</p>
            <div class="choice-grid">
              <button type="button" class="choice-chip" data-tag="low energy">Low</button>
              <button type="button" class="choice-chip" data-tag="medium energy">Medium</button>
              <button type="button" class="choice-chip" data-tag="high energy">High</button>
            </div>
          </div>
          <div>
            <p class="field-label">Body</p>
            <div class="choice-grid">
              <button type="button" class="choice-chip" data-tag="tight chest">Tight</button>
              <button type="button" class="choice-chip" data-tag="tired body">Tired</button>
              <button type="button" class="choice-chip" data-tag="foggy head">Foggy</button>
            </div>
          </div>
          <div>
            <p class="field-label">Need</p>
            <div class="choice-grid">
              <button type="button" class="choice-chip" data-tag="quiet">Quiet</button>
              <button type="button" class="choice-chip" data-tag="words">Words</button>
              <button type="button" class="choice-chip" data-tag="action">Action</button>
            </div>
          </div>
        </div>
        <button id="checkin-result-button" class="button button-primary" type="button">Show a gentle next step</button>
      </div>

      <div id="checkin-result" class="completion-card hidden stack" aria-live="polite">
        <p class="eyebrow">Suggested path</p>
        <h3 id="checkin-title">Start here</h3>
        <p id="checkin-copy" class="muted">Your recommendation will appear here.</p>
        <div class="button-row">
          <a id="checkin-tool-link" class="button button-soft" href={sitePath("/self-help/ground")}>Use tool</a>
          <a id="checkin-read-link" class="button button-secondary" href={resourceArticlePath("when-your-mind-will-not-slow-down")}>Read guide</a>
        </div>
      </div>

      <div class="card local-insight">
        <p class="eyebrow">Pattern view</p>
        <p id="checkin-history" class="muted">After a few check-ins, this space can show which feelings have been visiting most often.</p>
        <button id="checkin-clear" class="button button-soft" type="button">Clear check-ins</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <div class="split-heading">
        <div>
          <p class="eyebrow">Related reading</p>
          <h2>Words for what the check-in surfaces.</h2>
        </div>
        <p class="lede">These resources keep the same non-diagnostic, reflective tone.</p>
      </div>
      <div class="grid grid-3">
        {related.map((article) => <LinkCard title={article.title} text={article.description} href={resourceArticlePath(article.slug)} cta="Read guide" />)}
      </div>
    </div>
  </section>

  <script is:inline>
    const recommendations = {
      scattered: {
        title: "Ground before you solve.",
        copy: "When everything is pulling at you, the next kind step is sensory contact before analysis.",
        tool: "/self-help/ground",
        read: "/resources/when-your-mind-will-not-slow-down",
        cta: "Start grounding",
      },
      heavy: {
        title: "Lower the standard for the next hour.",
        copy: "Heavy days often need fewer demands, not stronger pressure. Choose one small reset.",
        tool: "/self-help/rituals",
        read: "/resources/a-reset-for-heavy-days",
        cta: "Build a ritual",
      },
      restless: {
        title: "Lengthen the exhale.",
        copy: "If your body feels wired, start with a paced breath before asking for reflection.",
        tool: "/self-help/breathe",
        read: "/resources/when-sleep-feels-far-away",
        cta: "Start breathing",
      },
      numb: {
        title: "Use words gently.",
        copy: "When feeling feels far away, a prompt can make contact without forcing clarity.",
        tool: "/self-help/journal",
        read: "/resources/the-loneliness-hidden-in-busy-lives",
        cta: "Open journal",
      },
    };

    const base = document.documentElement.dataset.basePath || "";
    const withBase = (path) => (base ? `${base}${path}` : path);
    let selectedFeeling = "";
    const selectedTags = new Set();

    const updateHistory = () => {
      const history = JSON.parse(localStorage.getItem("hs-checkins") || "[]");
      const counts = history.reduce((acc, item) => {
        acc[item.feeling] = (acc[item.feeling] || 0) + 1;
        return acc;
      }, {});
      const summary = Object.entries(counts).map(([feeling, count]) => `${feeling}: ${count}`).join(" / ");
      const historyEl = document.querySelector("#checkin-history");
      historyEl.textContent = summary ? `Recent pattern: ${summary}.` : "After a few check-ins, this space can show which feelings have been visiting most often.";
    };

    document.querySelectorAll("[data-feeling]").forEach((button) => {
      button.addEventListener("click", () => {
        selectedFeeling = button.dataset.feeling;
        document.querySelectorAll("[data-feeling]").forEach((tile) => tile.classList.toggle("is-active", tile === button));
      });
    });

    document.querySelectorAll("[data-tag]").forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.dataset.tag;
        if (selectedTags.has(tag)) selectedTags.delete(tag);
        else selectedTags.add(tag);
        button.classList.toggle("is-active");
      });
    });

    document.querySelector("#checkin-result-button")?.addEventListener("click", () => {
      const feeling = selectedFeeling || "scattered";
      const rec = recommendations[feeling];
      const history = JSON.parse(localStorage.getItem("hs-checkins") || "[]").slice(-29);
      history.push({ feeling, tags: Array.from(selectedTags), date: new Date().toISOString() });
      localStorage.setItem("hs-checkins", JSON.stringify(history));

      document.querySelector("#checkin-title").textContent = rec.title;
      document.querySelector("#checkin-copy").textContent = rec.copy;
      const toolLink = document.querySelector("#checkin-tool-link");
      const readLink = document.querySelector("#checkin-read-link");
      toolLink.href = withBase(rec.tool);
      toolLink.textContent = rec.cta;
      readLink.href = withBase(rec.read);
      document.querySelector("#checkin-result").classList.remove("hidden");
      updateHistory();
    });

    document.querySelector("#checkin-clear")?.addEventListener("click", () => {
      localStorage.removeItem("hs-checkins");
      updateHistory();
    });

    updateHistory();
  </script>
</BaseLayout>
