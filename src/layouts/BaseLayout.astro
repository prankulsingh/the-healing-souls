---
import Header from "@components/global/Header.astro";
import Footer from "@components/global/Footer.astro";
import SkipLink from "@components/global/SkipLink.astro";
import "@styles/global.css";
import { practitioner } from "@data/practitioner";
import { sitePath } from "@data/site-path";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${practitioner.brandName} | Counselling and gentle self-help`,
  description = "A warm, counselling-informed space for sessions, gentle self-help tools, and thoughtful resources.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const basePath = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en" data-base-path={basePath}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4efe8" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <SkipLink />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
